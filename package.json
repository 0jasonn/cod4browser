{
  "name": "kisakcod-browser-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser platform work for the KisakCOD COD4 reimplementation",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build:web": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build_web.ps1",
    "build:web:diagnostics": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build_web.ps1 -Diagnostics",
    "serve:web": "python tools/serve_web.py --directory build/web/site",
    "check:web:product": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/check_web_product_boundary.ps1",
    "check:web:lint": "eslint web/product_*.mjs web/asset_profile.mjs tests/node/*.mjs",
    "check:web:types": "tsc --allowJs --checkJs --noEmit --target ES2024 --module NodeNext --moduleResolution NodeNext web/product_protocol.mjs",
    "check:web:static": "npm run check:web:lint && npm run check:web:types",
    "test:protocol": "node --test tests/node/product_protocol.test.mjs",
    "test:browser": "playwright test --grep @smoke",
    "test:browser:product": "set KISAK_WEB_SITE=build/web/site&& set KISAK_WEB_TEST_PORT=8018&& set KISAK_WEB_PRODUCT_TEST=1&& playwright test tests/browser/product.spec.mjs",
    "test:browser:remainder": "playwright test --grep-invert \"@smoke|@native-covered\"",
    "test:browser:full": "playwright test"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "eslint": "10.9.0",
    "typescript": "7.0.2"
  }
}
