{
  "name": "kisakcod-browser-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser platform work for the KisakCOD COD4 reimplementation",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build:web": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build_web.ps1",
    "serve:web": "python tools/serve_web.py --directory build/web/site",
    "test:browser": "playwright test --grep @smoke",
    "test:browser:remainder": "playwright test --grep-invert \"@smoke|@native-covered\"",
    "test:browser:full": "playwright test"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
